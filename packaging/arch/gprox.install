# Enable gproxd for every user's session, as Arch does for PipeWire's own user
# units. A user opts out with: systemctl --user mask gproxd.service

post_install() {
  systemctl --global enable gproxd.service
  cat <<'MSG'
==> gprox: gproxd starts at your next login. To start it now:
==>     systemctl --user start gproxd
==> gprox's own EQ and Blue VO!CE presets work right away.
==> One-time setup, needs files from a Windows G HUB install (G HUB's Blue VO!CE
==> presets, battery percentage; also makes gprox the default output and input):
==>     gprox setup /path/to/LGHUB/depots/<number>/pro_headset
==> Without them, pick "PRO X (gprox)" and "PRO X Mic (gprox)" in your sound settings.
==> Your own G HUB presets: gprox import ghub /path/to/settings.db
==> Tray widget (KDE): Configure System Tray -> Entries -> gprox Headset.
==> Full steps: https://github.com/Unackn0wledged/Glinux-Hub-GProX#setup
MSG
}

post_upgrade() {
  echo '==> gprox: restart the daemon to use the new version: systemctl --user restart gproxd'
}

pre_remove() {
  systemctl --global disable gproxd.service
}

post_remove() {
  echo '==> gprox: stop a running daemon with: systemctl --user stop gproxd'
}
